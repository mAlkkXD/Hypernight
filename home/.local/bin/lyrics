#!/usr/bin/env python3
"""lyrics: letra sincronizada de Spotify en la terminal.

Uso:
  lyrics                 linea actual en grande (Ctrl+C para salir)
  lyrics --no-viz        sin visualizador de audio
  lyrics --dump          imprime la letra completa y sale
  lyrics --offset 0.5    adelanta/atrasa la sincronia en segundos
  lyrics fetch ...       pasa los argumentos al /usr/bin/lyrics original
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata

try:
    from PIL import Image, ImageDraw, ImageFont
    HAVE_PIL = True
except ImportError:  # sin Pillow se usa el modo de texto normal
    HAVE_PIL = False

PLAYER = "spotify"
LYRICS_BIN = "/usr/bin/lyrics"
SEP = "\x1f"
THEME_PATH = os.path.expanduser("~/.config/quickshell/theme.json")

REFRESH = 0.3
RESET = "\x1b[0m"
BOLD = "\x1b[1m"
CLEAR_LINE = "\x1b[2K"
CLEAR_DOWN = "\x1b[J"

ALT_ON = "\x1b[?1049h"
ALT_OFF = "\x1b[?1049l"
CURSOR_OFF = "\x1b[?25l"
CURSOR_ON = "\x1b[?25h"

LRC_RE = re.compile(r"^\[(\d+):(\d+(?:\.\d+)?)\]\s?(.*)$")
BARS = "▁▂▃▄▅▆▇█"
PIXEL_FONT = os.path.expanduser("~/.local/share/fonts/DotGothic16-Regular.ttf")
ART_CACHE = {}


# ------------------------------------------------------------------ utilidades


def clamp(value, low, high):
    return max(low, min(high, value))


def terminal_size():
    """Tamano real del tty; COLUMNS/LINES del entorno pueden mentir."""
    try:
        size = os.get_terminal_size(sys.stdout.fileno())
        return size.columns, size.lines
    except OSError:
        size = shutil.get_terminal_size()
        return size.columns, size.lines


def hex_to_rgb(value, fallback):
    value = (value or "").lstrip("#")
    if len(value) < 6:
        return fallback
    try:
        return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return fallback


def load_theme():
    theme = {
        "bg": (19, 12, 17),
        "text": (238, 223, 229),
        "subtext": (214, 193, 204),
        "outline": (158, 140, 150),
        "accent": (233, 196, 196),
        "accentSoft": (240, 214, 214),
    }
    try:
        with open(THEME_PATH, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        for key in list(theme):
            theme[key] = hex_to_rgb(data.get(key), theme[key])
    except (OSError, ValueError):
        pass
    return theme


def fg(rgb, bold=False):
    r, g, b = rgb
    return f"\x1b[{1 if bold else 22};38;2;{r};{g};{b}m"


def bg(rgb):
    r, g, b = rgb
    return f"\x1b[48;2;{r};{g};{b}m"


def display_width(text):
    width = 0
    for char in text:
        if unicodedata.combining(char):
            continue
        width += 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
    return width


def truncate(text, limit):
    if display_width(text) <= limit:
        return text
    out, used = "", 0
    for char in text:
        step = 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1
        if used + step > limit - 1:
            break
        out += char
        used += step
    return out + "…"


# --------------------------------------------------------------------- spotify


def mpris():
    fmt = SEP.join([
        "{{artist}}", "{{title}}", "{{mpris:length}}", "{{position}}", "{{status}}",
        "{{album}}",
    ])
    try:
        out = subprocess.run(
            ["playerctl", "-p", PLAYER, "metadata", "--format", fmt],
            capture_output=True, text=True, timeout=4,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    parts = out.stdout.rstrip("\n").split(SEP)
    if len(parts) < 5:
        return None

    def number(raw):
        try:
            return int(float(raw))
        except ValueError:
            return 0

    return {
        "artist": parts[0].strip(),
        "title": parts[1].strip(),
        "length": number(parts[2]),
        "position": number(parts[3]),
        "status": parts[4].strip(),
        "album": parts[5].strip() if len(parts) > 5 else "",
    }


def clean_title(title):
    cleaned = re.sub(r"\s*[\(\[](feat\.?|ft\.?|with)[^\)\]]*[\)\]]", "", title, flags=re.I)
    cleaned = re.sub(r"\s*-\s*(remaster(ed)?|single|radio edit|live)\b.*$", "", cleaned, flags=re.I)
    return cleaned.strip()


def clean_artist(artist):
    first = re.split(r"\s*(?:,|&|feat\.?|ft\.?|with)\s*", artist, maxsplit=1, flags=re.I)[0]
    return first.strip()


def fetch_lyrics(track):
    """Pide la letra a LRCLIB (via lyrics-git). Prefiere la sincronizada."""
    duration = max(1, round(track["length"] / 1_000_000))
    titles = [track["title"], clean_title(track["title"])]
    artists = [track["artist"], clean_artist(track["artist"])]

    fallback = None
    for artist in dict.fromkeys(artists):
        for title in dict.fromkeys(titles):
            if not title:
                continue
            try:
                out = subprocess.run(
                    [LYRICS_BIN, "fetch", "-t", title, "-a", artist, "-d", str(duration)],
                    capture_output=True, text=True, timeout=15,
                )
            except (OSError, subprocess.SubprocessError):
                return fallback or {"synced": [], "plain": [], "instrumental": False}

            if out.returncode != 0 or not out.stdout.strip():
                continue
            try:
                data = json.loads(out.stdout)
            except ValueError:
                continue  # el binario imprime "Error fetching lyrics: ..." en stdout

            synced = parse_lrc(data.get("SyncedLyrics") or "")
            plain = [line.rstrip() for line in (data.get("PlainLyrics") or "").splitlines()]
            result = {
                "synced": synced,
                "plain": plain,
                "instrumental": bool(data.get("Instrumental")),
            }
            if synced:
                return result
            if any(line.strip() for line in plain) and fallback is None:
                fallback = result

    return fallback or {"synced": [], "plain": [], "instrumental": False}


def parse_lrc(text):
    lines = []
    for raw in text.splitlines():
        match = LRC_RE.match(raw.strip())
        if not match:
            continue
        minutes, seconds, content = match.groups()
        lines.append((int(minutes) * 60 + float(seconds), content.strip()))
    lines.sort(key=lambda item: item[0])
    return lines


def current_index(synced, seconds):
    """Última línea con marca de tiempo; si cae en una pausa vacía se
    queda en la última línea cantada."""
    index = None
    for i, (stamp, _) in enumerate(synced):
        if stamp <= seconds:
            index = i
        else:
            break
    while index is not None and not synced[index][1].strip():
        index -= 1
    if index is not None and index < 0:
        index = None
    return index


# ------------------------------------------------------------------ visualizador


class Visualizer:
    """Barras de cava en modo raw."""

    CONFIG = """[general]
bars = {bars}
framerate = 30

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 16
bar_delimiter = 59
frame_delimiter = 10

[color]
gradient = 0
"""

    def __init__(self, bars=64):
        self.bars = bars
        self.values = [0] * bars
        self.proc = None
        self.path = None
        self.thread = None

    def start(self):
        if not shutil.which("cava"):
            return False
        try:
            handle = tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False)
            handle.write(self.CONFIG.format(bars=self.bars))
            handle.close()
            self.path = handle.name
            self.proc = subprocess.Popen(
                ["cava", "-p", self.path],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                text=True, bufsize=1,
            )
        except (OSError, subprocess.SubprocessError):
            self.stop()
            return False

        self.thread = threading.Thread(target=self._pump, daemon=True)
        self.thread.start()
        return True

    def _pump(self):
        try:
            for line in self.proc.stdout:
                values = []
                for chunk in line.strip().split(";"):
                    try:
                        values.append(int(chunk))
                    except ValueError:
                        continue
                if values:
                    self.values = values
        except (ValueError, OSError):
            pass

    def stop(self):
        if self.proc is not None:
            try:
                self.proc.terminate()
                self.proc.wait(timeout=1)
            except (OSError, subprocess.SubprocessError):
                pass
            self.proc = None
        if self.path:
            try:
                os.unlink(self.path)
            except OSError:
                pass
            self.path = None


# ---------------------------------------------------------------- letra grande


def pixel_font_path():
    """Fuente pixel con CJK; None si no esta instalada."""
    candidates = [PIXEL_FONT]
    candidates.append(os.path.expanduser("~/.fonts/DotGothic16-Regular.ttf"))
    candidates.append("/usr/share/fonts/TTF/DotGothic16-Regular.ttf")
    for path in candidates:
        if os.path.exists(path):
            return path
    for root in ("/usr/share/fonts", os.path.expanduser("~/.local/share/fonts")):
        for dirpath, _, files in os.walk(root):
            for name in files:
                if name.lower().startswith("dotgothic16"):
                    return os.path.join(dirpath, name)
    return None


def split_words(text):
    return re.findall(r"[A-Za-z0-9'\u2019\-]+|\s+|.", text)


def wrap_big(text, font, width):
    lines, current = [], ""
    for token in split_words(text):
        if token.isspace():
            if current:
                current += " "
            continue
        probe = current + token
        if not current or font.getlength(probe) <= width:
            current = probe
        else:
            lines.append(current.rstrip())
            current = token
    if current.strip():
        lines.append(current.rstrip())
    return lines


def wrap_plain(text, width, limit):
    """Envuelve texto normal por ancho visible, sin partir palabras latinas."""
    words = re.findall(r"[A-Za-z0-9'\u2019\-]+|\s+|.", text.strip())
    lines, current = [], ""
    for word in words:
        if word.isspace():
            if current:
                current += " "
            continue
        probe = current + word
        if not current or display_width(probe) <= width:
            current = probe
        else:
            lines.append(current.rstrip())
            current = word
    if current.strip():
        lines.append(current.rstrip())
    return lines[:limit]


def big_art(text, cols, rows):
    """Linea actual rasterizada con la fuente pixel, 1 px por celda."""
    key = (text, cols, rows)
    if key in ART_CACHE:
        return ART_CACHE[key]

    art = None
    path = pixel_font_path()
    if HAVE_PIL and path and cols >= 12 and rows >= 4:
        width, height = cols, rows * 2
        for size in (48, 32, 24, 16, 14, 12):
            # se dibuja en grande y se reduce: a tamano pequeno los trazos se rompen
            scale = 6 if size <= 16 else 3 if size <= 24 else 2
            font = ImageFont.truetype(path, size * scale)
            lines = wrap_big(text, font, width * scale)
            if not lines or len(lines) > 4:
                continue
            if " " not in text and len(lines) > 1:
                per = -(-len(text) // len(lines))
                balanced = [text[i:i + per] for i in range(0, len(text), per)]
                if len(balanced) == len(lines) and all(
                    font.getlength(part) <= width * scale for part in balanced
                ):
                    lines = balanced
            if any(font.getlength(line) > width * scale for line in lines):
                continue

            glyphs = []
            for line in lines:
                bbox = font.getbbox(line)
                if bbox[2] <= bbox[0] or bbox[3] <= bbox[1]:
                    continue
                big = Image.new("L", (bbox[2] - bbox[0], bbox[3] - bbox[1]), 0)
                ImageDraw.Draw(big).text((-bbox[0], -bbox[1]), line, font=font, fill=255)
                small = big.resize(
                    (max(1, round(big.width / scale)), max(1, round(big.height / scale))),
                    Image.LANCZOS,
                )
                glyphs.append(small.point(lambda value: 255 if value >= 85 else 0))
            if not glyphs:
                continue

            gap = max(2, size // 6)
            total = sum(glyph.height for glyph in glyphs) + gap * (len(glyphs) - 1)
            if total > height:
                continue

            canvas = Image.new("L", (width, height), 0)
            y = (height - total) // 2
            for glyph in glyphs:
                canvas.paste(glyph, ((width - glyph.width) // 2, y))
                y += glyph.height + gap

            pixels = canvas.load()
            out = []
            for half in range(rows):
                row = ""
                for x in range(cols):
                    top = pixels[x, half * 2] > 0
                    bottom = pixels[x, half * 2 + 1] > 0 if half * 2 + 1 < height else False
                    row += "\u2588" if top and bottom else "\u2580" if top else "\u2584" if bottom else " "
                out.append(row.rstrip())
            while out and not out[0]:
                out.pop(0)
            while out and not out[-1]:
                out.pop()
            art = out
            break

    if len(ART_CACHE) > 200:
        ART_CACHE.clear()
    ART_CACHE[key] = art
    return art


# ---------------------------------------------------------------------- render


def center(text, width):
    visible = display_width(text)
    if visible >= width:
        return truncate(text, width)
    left = (width - visible) // 2
    return " " * left + text + " " * (width - visible - left)


def render(track, lyrics, index, viz, theme):
    cols, rows = terminal_size()
    width = max(24, min(cols - 2, 120))
    width = min(width, max(10, cols - 2))
    height = rows - 1

    accent = theme["accent"]
    soft = theme["accentSoft"]
    subtext = theme["subtext"]
    outline = theme["outline"]
    bg_color = theme["bg"]

    x0 = max(1, (cols - width) // 2 + 1)
    inner = width - 2

    viz_rows = 3 if viz is not None and height >= 22 else 0
    text_rows = max(1, height - 2 - (viz_rows + 1 if viz_rows else 0))

    lines = [line for _, line in lyrics["synced"]] if lyrics["synced"] else lyrics["plain"]
    current = index if lyrics["synced"] else None

    out = []

    # borde superior
    out.append(
        f"\x1b[1;1H{CLEAR_LINE}\x1b[{x0}G{fg(accent)}╭{fg(outline)}"
        + "─" * inner + f"{fg(accent)}╮{RESET}"
    )

    # contenido: la linea actual en grande, centrada
    big = None
    big_color = accent
    if lyrics["synced"] and lines:
        text = lines[current] if current is not None else lines[0]
        if not text.strip():
            text = next((line for line in reversed(lines[:current or 1]) if line.strip()), "")
        if text.strip():
            big = big_art(text.strip(), inner - 2, text_rows)
            if big is None and viz_rows:
                # la letra manda: si no cabe con barras, se las quita
                wider = max(1, height - 2)
                alt = big_art(text.strip(), inner - 2, wider)
                if alt is not None:
                    big, text_rows, viz_rows = alt, wider, 0
            if current is None:
                big_color = outline
    elif lyrics["instrumental"]:
        big = big_art("Instrumental", inner - 2, text_rows)
        if big is None and viz_rows:
            wider = max(1, height - 2)
            alt = big_art("Instrumental", inner - 2, wider)
            if alt is not None:
                big, text_rows, viz_rows = alt, wider, 0

    row_cursor = 2
    if big:
        pad_top = max(0, (text_rows - len(big)) // 2)
        for offset in range(text_rows):
            prefix = f"\x1b[{row_cursor};1H{CLEAR_LINE}\x1b[{x0}G{fg(outline)}│"
            index = offset - pad_top
            body = ""
            if 0 <= index < len(big):
                line = big[index]
                pad = max(0, (inner - display_width(line)) // 2)
                body = f"\x1b[{x0 + 1 + pad}G{fg(big_color)}{line}{RESET}"
            out.append(prefix + body + f"\x1b[{x0 + width - 1}G{fg(outline)}│{RESET}")
            row_cursor += 1
    else:
        rows_to_draw = []
        if lyrics["synced"] and lines:
            text = (lines[current] if current is not None else lines[0]).strip()
            if text:
                rows_to_draw = [(line, "big") for line in wrap_plain(text, inner - 6, text_rows)]
        elif lyrics["instrumental"]:
            rows_to_draw = [("Instrumental", "big")]
        elif lyrics["plain"]:
            rows_to_draw = [(line, "dim") for line in lyrics["plain"][:max(1, text_rows - 2)]]
        else:
            rows_to_draw = [("sin letra", "dim")]

        pad_top = max(0, (text_rows - len(rows_to_draw)) // 2)
        cells = [None] * pad_top + rows_to_draw
        cells += [None] * max(0, text_rows - len(cells))

        for cell in cells:
            prefix = f"\x1b[{row_cursor};1H{CLEAR_LINE}\x1b[{x0}G{fg(outline)}│"
            body = ""
            if cell:
                text, style = cell
                text = truncate(text, inner - 6)
                if style == "big":
                    pad = max(0, (inner - display_width(text) - 2) // 2)
                    body = (
                        f"\x1b[{x0 + 1 + pad}G{fg(bg_color, True)}{bg(accent)} "
                        + text + f" {RESET}"
                    )
                else:
                    pad = max(0, (inner - display_width(text)) // 2)
                    body = f"\x1b[{x0 + 1 + pad}G{fg(subtext)}{text}{RESET}"
            out.append(prefix + body + f"\x1b[{x0 + width - 1}G{fg(outline)}│{RESET}")
            row_cursor += 1

    # visualizador (con una fila de aire antes)
    if viz_rows:
        out.append(
            f"\x1b[{row_cursor};1H{CLEAR_LINE}\x1b[{x0}G{fg(outline)}│"
            + f"\x1b[{x0 + width - 1}G{fg(outline)}│{RESET}"
        )
        row_cursor += 1
        values = list(viz.values) if viz else []
        count = max(1, min(len(values) or 1, (inner - 5) // 2))
        values = (values + [0] * count)[:count]
        top_accent = theme["accentSoft"]
        for level in range(viz_rows, 0, -1):
            pieces = []
            for value in values:
                h = clamp(value / 16.0, 0.0, 1.0) * viz_rows
                frac = h - (level - 1)
                if frac >= 1:
                    pieces.append(BARS[-1])
                elif frac > 0.02:
                    pieces.append(BARS[max(0, int(frac * 8) - 1)])
                else:
                    pieces.append(" ")
            line = " ".join(pieces).rstrip()
            pad = max(0, (inner - display_width(line)) // 2)
            color = top_accent if level == viz_rows else accent
            out.append(
                f"\x1b[{row_cursor};1H{CLEAR_LINE}\x1b[{x0}G{fg(outline)}│"
                + f"\x1b[{x0 + 1 + pad}G{fg(color)}{line}{RESET}"
                + f"\x1b[{x0 + width - 1}G{fg(outline)}│{RESET}"
            )
            row_cursor += 1

    # borde inferior con progreso
    position = track["position"] / 1_000_000
    length = max(1.0, track["length"] / 1_000_000)
    ratio = clamp(position / length, 0.0, 1.0)
    filled = int(inner * ratio)
    out.append(
        f"\x1b[{row_cursor};1H{CLEAR_LINE}\x1b[{x0}G{fg(accent)}╰"
        + "━" * filled
        + f"{fg(outline)}" + "─" * (inner - filled)
        + f"{fg(accent)}╯{RESET}{CLEAR_DOWN}"
    )

    return out


# ------------------------------------------------------------------------ main


class Screen:
    def __init__(self):
        self.active = False

    def __enter__(self):
        sys.stdout.write(ALT_ON + CURSOR_OFF)
        sys.stdout.flush()
        self.active = True
        return self

    def __exit__(self, *exc):
        if self.active:
            sys.stdout.write(CURSOR_ON + ALT_OFF)
            sys.stdout.flush()
            self.active = False

    def draw(self, rows):
        sys.stdout.write("".join(rows))
        sys.stdout.flush()


def run_tui(offset, use_viz):
    theme = load_theme()
    cache = {}
    key = None
    lyrics = None
    loading = False
    viz = None

    if use_viz:
        candidate = Visualizer()
        if candidate.start():
            viz = candidate

    try:
        with Screen() as screen:
            while True:
                track = mpris()
                if track is None:
                    screen.draw([
                        f"\x1b[1;1H{CLEAR_LINE}{fg(theme['subtext'])}"
                        "  Spotify no está reproduciendo" + RESET + CLEAR_DOWN,
                    ])
                    time.sleep(REFRESH)
                    continue

                track_key = (track["artist"], track["title"], track["length"])
                if track_key != key:
                    key = track_key
                    lyrics = cache.get(track_key)
                    if lyrics is None:
                        loading = True
                        screen.draw([
                            f"\x1b[1;1H{CLEAR_LINE}{fg(theme['subtext'])}"
                            "  buscando letra…" + RESET + CLEAR_DOWN,
                        ])
                        lyrics = fetch_lyrics(track)
                        cache[track_key] = lyrics
                        loading = False

                if loading and lyrics is None:
                    time.sleep(REFRESH)
                    continue

                index = None
                if lyrics["synced"]:
                    seconds = track["position"] / 1_000_000 + offset
                    index = current_index(lyrics["synced"], seconds)

                shown = lyrics
                if not shown["synced"] and not shown["plain"] and not shown["instrumental"]:
                    shown = {"synced": [], "plain": ["sin letra"], "instrumental": False}
                    index = None

                screen.draw(render(track, shown, index, viz, theme))
                time.sleep(REFRESH)
    finally:
        if viz is not None:
            viz.stop()


def dump(offset):
    track = mpris()
    if track is None:
        print("Spotify no está reproduciendo", file=sys.stderr)
        return 1

    lyrics = fetch_lyrics(track)
    if lyrics["instrumental"]:
        print("Instrumental")
        return 0

    if lyrics["synced"]:
        if offset:
            seconds = track["position"] / 1_000_000 + offset
            index = current_index(lyrics["synced"], seconds)
            if index is not None:
                print(f"-- {lyrics['synced'][index][0]:.2f}s")
        for _, line in lyrics["synced"]:
            print(line)
        return 0

    if lyrics["plain"]:
        print("\n".join(lyrics["plain"]))
        return 0

    print("sin letra", file=sys.stderr)
    return 1


def usage():
    print(__doc__.strip())
    return 0


def main(argv):
    args = list(argv[1:])

    if args and args[0] in ("fetch", "help"):
        os.execv(LYRICS_BIN, [LYRICS_BIN] + args)

    offset = 0.0
    if "--offset" in args:
        i = args.index("--offset")
        try:
            offset = float(args[i + 1])
        except (IndexError, ValueError):
            print("valor inválido para --offset", file=sys.stderr)
            return 2
        del args[i:i + 2]

    use_viz = "--no-viz" not in args
    args = [a for a in args if a != "--no-viz"]

    if "-h" in args or "--help" in args:
        return usage()

    if args and args[0] != "--dump":
        return usage()

    if "--dump" in args or not sys.stdout.isatty():
        return dump(offset)

    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))

    try:
        run_tui(offset, use_viz)
    except KeyboardInterrupt:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
